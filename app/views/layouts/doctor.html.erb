<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.doctor.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="doctor-layout">
    <header class="doctor-header">
      <div class="doctor-header__brand">
        <span class="doctor-header__logo">🩺</span>
        <div>
          <div class="doctor-header__title"><%= t("app.name") %> — <%= t("app.doctor.title") %></div>
          <div class="doctor-header__subtitle"><%= t("app.doctor.subtitle") %></div>
        </div>
      </div>

      <nav class="doctor-header__nav">
        <%= link_to t("app.doctor.title"), doctor_root_path, class: "doctor-nav__link" %>
      </nav>

      <div class="doctor-header__user">
        <span class="doctor-header__name">Dr(a). <%= current_user.name %></span>
        <%= link_to t("app.nav.logout"), destroy_user_session_path,
              data: { turbo_method: :delete },
              class: "doctor-header__logout" %>
      </div>
    </header>

    <% if notice.present? %>
      <div class="flash flash--notice"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="flash flash--alert"><%= alert %></div>
    <% end %>

    <main class="doctor-main">
      <%= yield %>
    </main>
  </body>
</html>
