<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

  </head>

  <body class="app-layout">

    <header class="app-header">
      <div class="app-header__brand">
        <%= link_to root_path, class: "app-header__logo-link" do %>
          <span class="app-header__logo-icon">+</span>
          <span class="app-header__logo-text">Triagem<strong>AI</strong></span>
        <% end %>
      </div>

      <nav class="app-header__nav">
        <% if user_signed_in? && current_user.patient? %>
          <%= link_to t("app.nav.patient"), patient_app_path, class: "app-nav__link" %>
        <% end %>
        <%= link_to t("app.nav.queue_tv"), queue_tv_path, class: "app-nav__link app-nav__link--secondary" %>
        <% if user_signed_in? && current_user.colaborador? %>
          <%= link_to t("app.nav.validation"), validation_root_path, class: "app-nav__link" %>
        <% end %>
        <% if user_signed_in? && current_user.specialist? %>
          <%= link_to t("app.nav.attendance"), attendance_root_path, class: "app-nav__link" %>
        <% end %>
        <% if user_signed_in? && current_user.admin? %>
          <%= link_to "Configuração IA", edit_admin_triage_setting_path, class: "app-nav__link" %>
          <%= link_to "Equipe", admin_users_path, class: "app-nav__link" %>
        <% end %>
        <% if user_signed_in? %>
          <%= link_to t("app.nav.logout"), destroy_user_session_path,
                data: { turbo_method: :delete },
                class: "app-nav__link app-nav__link--logout" %>
        <% end %>
      </nav>
    </header>

    <% if notice.present? %>
      <div class="flash flash--notice"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="flash flash--alert"><%= alert %></div>
    <% end %>

    <main class="app-main">
      <%= yield %>
    </main>

  </body>
</html>
