<% content_for :title, t("devise.registrations.new.title") %>

<div class="auth-page">
  <div class="auth-card auth-card--wide">

    <div class="auth-card__header">
      <div class="auth-card__icon auth-card__icon--patient">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <line x1="19" y1="8" x2="19" y2="14"/>
          <line x1="22" y1="11" x2="16" y2="11"/>
        </svg>
      </div>
      <h1 class="auth-card__title"><%= t("devise.registrations.new.title") %></h1>
      <p class="auth-card__subtitle"><%= t("devise.registrations.new.subtitle") %></p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
          html: { class: "auth-form" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <%# ── Dados pessoais ── %>
      <div class="auth-section-label"><%= t("devise.registrations.new.personal_data") %></div>

      <div class="auth-field">
        <%= f.label :name, t("activerecord.attributes.user.name"), class: "auth-label" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name",
              class: "auth-input",
              placeholder: t("devise.registrations.new.name_placeholder") %>
      </div>

      <div class="auth-row">
        <div class="auth-field">
          <%= f.label :cpf, t("activerecord.attributes.user.cpf"), class: "auth-label" %>
          <%= f.text_field :cpf, autocomplete: "off",
                class: "auth-input", placeholder: "000.000.000-00",
                data: { controller: "mask", mask_type_value: "cpf" },
                maxlength: 14, inputmode: "numeric" %>
        </div>
        <div class="auth-field">
          <%= f.label :birth_date, t("activerecord.attributes.user.birth_date"), class: "auth-label" %>
          <%= f.date_field :birth_date, class: "auth-input" %>
        </div>
      </div>

      <div class="auth-field" data-controller="require-phone-for-sms">
        <%= f.label :phone, t("activerecord.attributes.user.phone"), class: "auth-label" %>
        <%= f.telephone_field :phone, autocomplete: "tel",
              class: "auth-input", placeholder: "(11) 99999-9999",
              data: { controller: "mask", mask_type_value: "phone", require_phone_for_sms_target: "phone" },
              maxlength: 15, inputmode: "numeric" %>

        <label class="priority-switch">
          <%= f.check_box :sms_notifications_enabled,
                data: { require_phone_for_sms_target: "checkbox", action: "change->require-phone-for-sms#sync" } %>
          <span class="priority-switch__label">Avisar por SMS quando eu for chamado</span>
        </label>
      </div>

      <%# ── Prioridade no atendimento (Lei 10.048/2000) ── %>
      <div class="auth-section-label auth-section-label--mt">Prioridade no atendimento (opcional)</div>
      <p class="auth-hint">
        Pessoas idosas (60+) são identificadas automaticamente pela data de nascimento, e obesidade
        é calculada automaticamente pelo IMC a partir da altura e peso informados abaixo.
      </p>

      <div class="auth-row">
        <div class="auth-field">
          <%= f.label :height_cm, t("activerecord.attributes.user.height_cm"), class: "auth-label" %>
          <%= f.number_field :height_cm, class: "auth-input", placeholder: "170", min: 50, max: 250 %>
        </div>
        <div class="auth-field">
          <%= f.label :weight_kg, t("activerecord.attributes.user.weight_kg"), class: "auth-label" %>
          <%= f.number_field :weight_kg, class: "auth-input", placeholder: "70", min: 1, max: 400, step: "0.1" %>
        </div>
      </div>

      <label class="priority-switch">
        <%= f.check_box :pcd %>
        <span class="priority-switch__label">Pessoa com deficiência (inclui TEA)</span>
      </label>

      <label class="priority-switch">
        <%= f.check_box :mobilidade_reduzida %>
        <span class="priority-switch__label">Mobilidade reduzida</span>
      </label>

      <div class="priority-condition" data-controller="toggle-field">
        <label class="priority-switch">
          <%= f.check_box :gestante, data: { toggle_field_target: "checkbox", action: "change->toggle-field#sync" } %>
          <span class="priority-switch__label">Gestante</span>
        </label>
        <div class="auth-field priority-condition__field" data-toggle-field-target="field">
          <%= f.label :gestante_valid_until, "Válido até", class: "auth-label" %>
          <%= f.date_field :gestante_valid_until, class: "auth-input", min: Date.current.iso8601 %>
        </div>
      </div>

      <div class="priority-condition" data-controller="toggle-field">
        <label class="priority-switch">
          <%= f.check_box :lactante, data: { toggle_field_target: "checkbox", action: "change->toggle-field#sync" } %>
          <span class="priority-switch__label">Lactante</span>
        </label>
        <div class="auth-field priority-condition__field" data-toggle-field-target="field">
          <%= f.label :lactante_valid_until, "Válido até", class: "auth-label" %>
          <%= f.date_field :lactante_valid_until, class: "auth-input", min: Date.current.iso8601 %>
        </div>
      </div>

      <div class="priority-condition" data-controller="toggle-field">
        <label class="priority-switch">
          <%= f.check_box :crianca_de_colo, data: { toggle_field_target: "checkbox", action: "change->toggle-field#sync" } %>
          <span class="priority-switch__label">Criança de colo</span>
        </label>
        <div class="auth-field priority-condition__field" data-toggle-field-target="field">
          <%= f.label :crianca_de_colo_valid_until, "Válido até", class: "auth-label" %>
          <%= f.date_field :crianca_de_colo_valid_until, class: "auth-input", min: Date.current.iso8601 %>
        </div>
      </div>

      <%# ── Acesso ── %>
      <div class="auth-section-label auth-section-label--mt"><%= t("devise.registrations.new.access_data") %></div>

      <div class="auth-field">
        <%= f.label :email, t("activerecord.attributes.user.email"), class: "auth-label" %>
        <%= f.email_field :email, autocomplete: "email",
              class: "auth-input", placeholder: "seu@email.com" %>
      </div>

      <div class="auth-row">
        <div class="auth-field">
          <%= f.label :password, t("activerecord.attributes.user.password"), class: "auth-label" %>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "auth-input", placeholder: "••••••••" %>
          <% if @minimum_password_length %>
            <span class="auth-hint">(<%= @minimum_password_length %> <%= t("devise.registrations.new.password_hint") %>)</span>
          <% end %>
        </div>
        <div class="auth-field">
          <%= f.label :password_confirmation, t("activerecord.attributes.user.password_confirmation"), class: "auth-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "auth-input", placeholder: "••••••••" %>
        </div>
      </div>

      <div class="auth-actions">
        <%= f.submit t("devise.registrations.new.submit"), class: "btn btn--primary btn--full btn--lg" %>
      </div>

    <% end %>

    <div class="auth-links">
      <%= link_to t("devise.shared.links.sign_in"), new_user_session_path, class: "auth-link" %>
    </div>

    <div class="auth-card__footer">
      <%= link_to "← #{t("app.home.back")}", root_path, class: "auth-link auth-link--muted" %>
    </div>

  </div>
</div>
