<% content_for :title, t("app.validation.title") %>

<%# ── Page header ── %>
<div class="panel-page-header">
  <div class="panel-page-header__left">
    <h1 class="panel-page-header__title"><%= t("app.validation.title") %></h1>
    <p class="panel-page-header__subtitle"><%= t("app.validation.subtitle") %></p>
  </div>
  <div class="panel-page-header__stats">
    <% if @show_validation_column %>
      <div class="panel-stat panel-stat--yellow">
        <span class="panel-stat__value" data-validation-panel-target="awaitingCount"><%= @awaiting_validation.count %></span>
        <span class="panel-stat__label">Aguardando validação</span>
      </div>
    <% end %>
    <div class="panel-stat panel-stat--green">
      <span class="panel-stat__value" data-validation-panel-target="queueCount"><%= @total_waiting %></span>
      <span class="panel-stat__label">Na fila</span>
    </div>
  </div>
  <div class="panel-page-header__actions">
  </div>
</div>

<% if @show_checkin_section %>
  <%# ── Triagens aguardando a pessoa chegar no local ── %>
  <section class="checkin-section" data-controller="list-filter">
    <div class="checkin-section__header">
      <div>
        <h2 class="checkin-section__title">Aguardando check-in <span class="colaborador-column__badge"><%= @awaiting_checkin.size %></span></h2>
        <p class="checkin-section__subtitle">Triagem já feita (às vezes de casa). Confirme a presença de quem chegou sem fazer o check-in pelo app.</p>
      </div>
      <input type="search" class="validation-textarea checkin-section__search" placeholder="Buscar por nome ou CPF"
        data-list-filter-target="input" data-action="input->list-filter#filter">
    </div>

    <% if @awaiting_checkin.empty? %>
      <p class="checkin-section__empty">Ninguém aguardando check-in no momento.</p>
    <% else %>
      <div class="checkin-list">
        <% @awaiting_checkin.each do |session| %>
          <% level = session.ai_classification&.urgency_level %>
          <div class="checkin-item" data-list-filter-target="item"
            data-filter-text="<%= session.user.name %> <%= session.user.cpf.to_s.gsub(/\D/, "") %>"
            style="border-left: 4px solid <%= urgency_color(level) %>;">
            <div class="checkin-item__info">
              <div class="checkin-item__name"><%= session.user.name %></div>
              <div class="checkin-item__meta">
                CPF <%= masked_cpf(session.user.cpf) %> · triagem às <%= l(session.finished_at, format: :short) %>
                <% if (deadline = session.checkin_deadline) %>
                  · expira às <%= l(deadline, format: :short) %>
                <% end %>
              </div>
            </div>
            <% if level %>
              <span class="colaborador-card__urgency-badge" style="<%= urgency_badge_style(level) %>"><%= urgency_label(level) %></span>
            <% end %>
            <%= button_to "Confirmar presença", validation_triage_session_check_in_path(session),
                  method: :post, class: "colaborador-card__action colaborador-card__action--call checkin-item__action" %>
          </div>
        <% end %>
        <p class="checkin-section__empty" data-list-filter-target="empty" hidden>Nenhum resultado para a busca.</p>
      </div>
    <% end %>
  </section>
<% end %>

<div class="colaborador-panel <%= "colaborador-panel--single" unless @show_validation_column %>"
  data-controller="validation-panel">

  <% if @show_validation_column %>
  <%# ── Left column: awaiting colaborador validation ── %>
  <section class="colaborador-column colaborador-column--validation">
    <div class="colaborador-column__header colaborador-column__header--yellow">
      <div class="colaborador-column__header-left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.8;">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        <h2 class="colaborador-column__title"><%= t("app.validation.awaiting_validation") %></h2>
      </div>
      <span class="colaborador-column__badge" data-validation-panel-target="awaitingCount">
        <%= @awaiting_validation.count %>
      </span>
    </div>

    <div class="colaborador-column__body" data-validation-panel-target="awaitingList">
      <% if @awaiting_validation.empty? %>
        <div class="colaborador-empty-state">
          <div class="colaborador-empty-state__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.4">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <p><%= t("app.validation.no_pending") %></p>
        </div>
      <% else %>
        <% @awaiting_validation.each do |session| %>
          <% classification = session.ai_classification %>
          <% level = classification&.urgency_level %>
          <div class="colaborador-card" style="border-left: 5px solid <%= urgency_color(level) %>;">
            <div class="colaborador-card__top">
              <div class="colaborador-card__urgency-badge" style="<%= urgency_badge_style(level) %>">
                <%= urgency_label(level) %>
              </div>
              <% if classification&.needs_review? %>
                <span class="colaborador-card__confidence-badge" title="Confiança da IA baixa — revise com atenção">
                  ⚠ Confiança baixa
                </span>
              <% end %>
              <span class="colaborador-card__time">
                <%= l(session.created_at, format: :short) %>
              </span>
            </div>

            <div class="colaborador-card__name"><%= session.user.name %></div>
            <div class="colaborador-card__complaint"><%= session.initial_demand %></div>

            <% if classification&.summary.present? %>
              <div class="colaborador-card__summary"><%= classification.summary.truncate(120) %></div>
            <% end %>

            <%= link_to t("app.validation.validate_button"),
              new_validation_triage_validation_path(triage_session_id: session.id),
                  class: "colaborador-card__action colaborador-card__action--validate" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
  <% end %>

  <%# ── Right column: validated sessions waiting in queue ── %>
  <section class="colaborador-column colaborador-column--queue">
    <div class="colaborador-column__header colaborador-column__header--green">
      <div class="colaborador-column__header-left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.8;">
          <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
          <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
        </svg>
        <h2 class="colaborador-column__title"><%= t("app.validation.priority_queue") %></h2>
      </div>
      <span class="colaborador-column__badge" data-validation-panel-target="queueCount">
        <%= @total_waiting %>
      </span>
    </div>

    <div class="colaborador-column__body" data-validation-panel-target="queueList">
      <% if @priority_queue.empty? %>
        <div class="colaborador-empty-state">
          <div class="colaborador-empty-state__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.4">
              <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <p><%= t("app.validation.queue_empty") %></p>
        </div>
      <% else %>
        <% @priority_queue.each_with_index do |entry, idx| %>
          <% session     = entry.triage_session %>
          <% validation  = session.ai_classification&.triage_validation %>
          <% final_level = validation&.final_urgency_level || session.ai_classification&.urgency_level %>
          <% final_label = urgency_label(final_level) %>

          <div class="colaborador-card" style="border-left: 5px solid <%= urgency_color(final_level) %>;">
            <div class="colaborador-card__top">
              <span class="colaborador-card__position">#<%= idx + 1 %></span>
              <div class="colaborador-card__urgency-badge" style="<%= urgency_badge_style(final_level) %>">
                <%= final_label %>
              </div>
              <% if entry.priority_tier > 0 %>
                <% reason_labels = entry.priority_reasons.map { |r| User::PRIORITY_REASON_LABELS[r.to_sym] }.join(", ") %>
                <span class="colaborador-card__priority-badge <%= "colaborador-card__priority-badge--super" if entry.priority_tier == 2 %>" title="<%= reason_labels %> (Lei 10.048/2000)">
                  ★ <%= reason_labels %>
                </span>
              <% end %>
              <% if entry.sla_breached? %>
                <span class="colaborador-card__sla-badge" title="Aguardando há mais tempo do que o SLA configurado para este nível de urgência (<%= entry.sla_minutes %> min)">
                  ⏱ SLA estourado
                </span>
              <% end %>
              <span class="colaborador-card__ticket"><%= entry.ticket_number %></span>
            </div>

            <div class="colaborador-card__name"><%= session.user.name %></div>
            <div class="colaborador-card__complaint"><%= session.initial_demand %></div>

            <div class="colaborador-card__meta">
              <%= t("app.validation.arrived_at") %>: <%= l(entry.queued_at, format: :short) %>
              · aguardando há <%= entry.waiting_minutes.round %> min
            </div>

            <%= button_to t("app.validation.call_button"),
                  call_validation_queue_entry_path(entry),
                  method: :patch,
                  class: "colaborador-card__action colaborador-card__action--call" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

</div>
