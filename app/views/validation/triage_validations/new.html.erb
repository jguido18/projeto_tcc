<% content_for :title, t("app.validation.validation_modal.title") %>

<div class="validation-page">

  <%# ── AI Analysis panel ── %>
  <section class="validation-ai-panel">
    <div class="validation-ai-panel__header">
      <span class="validation-ai-panel__label"><%= t("app.validation.validation_modal.ai_analysis") %></span>
      <div class="urgency-badge" style="<%= urgency_badge_style(@ai_classification.urgency_level) %>">
        <%= @ai_classification.urgency_label %>
      </div>
    </div>

    <div class="validation-ai-panel__body">
      <% priority_reasons = @triage_session.user.priority_reasons %>
      <% if priority_reasons.any? %>
        <div class="validation-section">
          <div class="validation-section__title"><%= t("app.validation.validation_modal.patient_priority") %></div>
          <div class="validation-section__content validation-section__content--symptoms">
            <% priority_reasons.each do |reason| %>
              <span class="symptom-tag symptom-tag--priority <%= "symptom-tag--priority-super" if reason == :super_elderly %>">
                ★ <%= User::PRIORITY_REASON_LABELS[reason] %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="validation-section">
        <div class="validation-section__title"><%= t("app.validation.validation_modal.suggested_classification") %></div>
        <div class="validation-section__content">
          <span class="urgency-chip" style="<%= urgency_badge_style(@ai_classification.urgency_level) %>">
            <%= @ai_classification.urgency_label %>
          </span>
          <% if @ai_classification.protocol_reference.present? %>
            <span class="validation-manchester"><%= @ai_classification.protocol_reference %></span>
          <% end %>
        </div>
      </div>

      <div class="validation-section">
        <div class="validation-section__title"><%= t("app.validation.validation_modal.clinical_summary") %></div>
        <div class="validation-section__content"><%= @ai_classification.summary %></div>
      </div>

      <% if @ai_classification.classification_reasoning.present? %>
        <div class="validation-section">
          <div class="validation-section__title"><%= t("app.validation.validation_modal.classification_reasoning") %></div>
          <div class="validation-section__content"><%= @ai_classification.classification_reasoning %></div>
        </div>
      <% end %>

      <% if @ai_classification.identified_symptoms.present? %>
        <div class="validation-section">
          <div class="validation-section__title"><%= t("activerecord.attributes.ai_classification.identified_symptoms") %></div>
          <div class="validation-section__content validation-section__content--symptoms">
            <% Array(@ai_classification.identified_symptoms).each do |symptom| %>
              <span class="symptom-tag"><%= symptom %></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @ai_classification.routing_suggestion.present? %>
        <div class="validation-section">
          <div class="validation-section__title"><%= t("activerecord.attributes.ai_classification.routing_suggestion") %></div>
          <div class="validation-section__content"><%= @ai_classification.routing_suggestion %></div>
        </div>
      <% end %>
    </div>
  </section>

  <%# ── Nursing evaluation form ── %>
  <section class="validation-form-panel">
    <div class="validation-form-panel__header">
      <span class="validation-form-panel__label"><%= t("app.validation.validation_modal.team_evaluation") %></span>
    </div>

    <%= form_with model: @validation, url: validation_triage_validations_path, local: false,
                  data: { controller: "validation-form" } do |f| %>

      <%= f.hidden_field :triage_session_id, value: @triage_session.id %>

      <% if @validation.errors.any? %>
        <div class="validation-errors">
          <ul>
            <% @validation.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Priority selector ── displayed as colored radio cards %>
      <div class="validation-field">
        <label class="validation-label"><%= t("app.validation.validation_modal.confirm_or_adjust") %></label>

        <div class="urgency-selector">
          <% @urgency_levels.each do |level| %>
            <% level_key = level["key"] %>
            <% selected = @validation.final_urgency_level == level_key %>
            <label class="urgency-option <%= "urgency-option--selected" if selected %>"
                   style="border-color:<%= level['color'] %>; <%= urgency_soft_style(level_key, 0.12) if selected %>">
              <%= f.radio_button :final_urgency_level, level_key,
                    data: { action: "change->validation-form#onUrgencyChange" } %>
              <span class="urgency-option__label" style="color:<%= level['color'] %>"><%= level["label"] %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%# Decision (auto-derived in JS, but also sent as hidden for server fallback) %>
      <%= f.hidden_field :decision, value: "confirmed",
            data: { "validation-form-target": "decision" } %>

      <%# Notes ── required only when adjusted/rejected %>
      <div class="validation-field">
        <label class="validation-label" for="triage_validation_notes">
          <%= t("app.validation.validation_modal.notes_label") %>
        </label>
        <%= f.text_area :notes, rows: 4,
              placeholder: t("app.validation.validation_modal.notes_placeholder"),
              class: "validation-textarea",
              id: "triage_validation_notes" %>
        <p class="validation-hint"><%= t("app.validation.validation_modal.notes_hint") %></p>
      </div>

      <div class="validation-actions">
        <%= link_to t("app.validation.validation_modal.cancel"), validation_root_path,
              class: "btn btn--secondary" %>
        <%= f.submit t("app.validation.validation_modal.confirm"), class: "btn btn--primary" %>
      </div>

    <% end %>
  </section>

</div>
