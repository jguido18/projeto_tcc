<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.attendance.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body class="specialist-layout">
    <header class="staff-header">
      <%# Brand %>
      <%= link_to attendance_root_path, class: "staff-header__brand" do %>
        <%= image_tag "logo.svg", width: 28, height: 28, alt: "TriagemAI", style: "border-radius:7px; flex-shrink:0;" %>
        <span class="staff-header__logo-text">Triagem<strong>AI</strong></span>
      <% end %>

      <div class="staff-header__divider"></div>

      <%# Nav principal %>
      <nav class="staff-header__nav">
        <% if current_user.admin? || current_user.colaborador? %>
          <%= link_to "Validação", validation_root_path,
                class: "staff-nav__link #{current_page?(validation_root_path) ? "staff-nav__link--active" : ""}" %>
          <div class="staff-nav__sep"></div>
        <% end %>

        <%= link_to "Atendimento", attendance_root_path,
              class: "staff-nav__link #{current_page?(attendance_root_path) ? "staff-nav__link--active" : ""}" %>

        <%= link_to "Histórico", attendance_history_path,
              class: "staff-nav__link #{current_page?(attendance_history_path) ? "staff-nav__link--active" : ""}" %>

        <div class="staff-nav__sep"></div>

        <%= link_to "Relatórios", validation_reports_path,
              class: "staff-nav__link #{current_page?(validation_reports_path) ? "staff-nav__link--active" : ""}" %>

        <% if current_user.admin? %>
          <div class="staff-nav__sep"></div>
          <%= link_to "Equipe", admin_users_path,
                class: "staff-nav__link #{current_page?(admin_users_path) ? "staff-nav__link--active" : ""}" %>
          <div class="staff-nav__sep"></div>
          <%= link_to "Configuração IA", edit_admin_triage_setting_path,
                class: "staff-nav__link #{current_page?(edit_admin_triage_setting_path) ? "staff-nav__link--active" : ""}" %>
        <% end %>
      </nav>

      <div class="staff-header__divider"></div>

      <%# Usuário %>
      <div class="staff-header__user">
        <%= render "shared/staff_user_dropdown" %>
      </div>
    </header>

    <%= render "shared/toasts" %>

    <main class="specialist-main">
      <%= yield %>
    </main>
  </body>
</html>
