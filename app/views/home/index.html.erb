<% content_for :title, t("app.name") %>

<div class="home-page home-page--landing">

  <%# ── Hero ── %>
  <section class="home-hero-section">
    <div class="home-hero-content">
      <div class="home-hero__badge">
        <span class="home-hero__badge-dot"></span>
        <%= t("app.tagline") %>
      </div>
      <h1 class="home-hero__title">
        Triagem<strong>AI</strong>
      </h1>
      <p class="home-hero__subtitle">
        Plataforma inteligente de triagem universal - classifique, priorize e gerencie atendimentos em tempo real com o apoio de inteligência artificial.
      </p>
      <div class="home-hero__actions">
        <%= link_to "Iniciar Triagem", new_user_session_path, class: "btn btn--primary btn--lg" %>
        <%= link_to "Acesso da Equipe", new_staff_session_path, class: "btn btn--hero-outline btn--lg" %>
      </div>
      <div class="home-hero__trust">
        <span class="home-hero__trust-item">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .5a7.5 7.5 0 1 0 0 15A7.5 7.5 0 0 0 8 .5Zm3.28 5.78-4 4a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 0 1 1.06-1.06L6.75 8.69l3.47-3.47a.75.75 0 0 1 1.06 1.06Z"/></svg>
          Triagem automatizada com IA
        </span>
        <span class="home-hero__trust-item">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .5a7.5 7.5 0 1 0 0 15A7.5 7.5 0 0 0 8 .5Zm3.28 5.78-4 4a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 0 1 1.06-1.06L6.75 8.69l3.47-3.47a.75.75 0 0 1 1.06 1.06Z"/></svg>
          Classificação por níveis de urgência
        </span>
        <span class="home-hero__trust-item">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .5a7.5 7.5 0 1 0 0 15A7.5 7.5 0 0 0 8 .5Zm3.28 5.78-4 4a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 0 1 1.06-1.06L6.75 8.69l3.47-3.47a.75.75 0 0 1 1.06 1.06Z"/></svg>
          Fila em tempo real
        </span>
      </div>
    </div>

    <div class="home-hero-illustration">
      <div class="hero-images-container">
        <%= image_tag "WhatsApp Image 2026-06-11 at 11.18.39.jpeg", alt: "Triagem Chat", class: "hero-image" %>
        <%= image_tag "WhatsApp Image 2026-06-11 at 11.18.35.jpeg", alt: "Triagem Start", class: "hero-image" %>
      </div>
    </div>
  </section>

  <%# ── Recursos ── %>
  <section class="home-features">
    <div class="home-section-header">
      <p class="home-section__label">O que oferecemos</p>
      <h2 class="home-section__title">Triagem inteligente do início ao fim</h2>
      <p class="home-section__desc">Do primeiro contato até o atendimento, o TriagemAI automatiza e organiza cada etapa do fluxo.</p>
    </div>

    <div class="home-features-grid">

      <div class="home-feature-card">
        <div class="home-feature-card__icon home-feature-card__icon--blue">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <h3 class="home-feature-card__title">Triagem por Chat com IA</h3>
        <p class="home-feature-card__desc">O solicitante descreve sua necessidade em linguagem natural. O assistente de IA faz as perguntas certas e coleta informações com precisão.</p>
      </div>

      <div class="home-feature-card">
        <div class="home-feature-card__icon home-feature-card__icon--purple">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4l3 3"/>
          </svg>
        </div>
        <h3 class="home-feature-card__title">Classificação Automática</h3>
        <p class="home-feature-card__desc">A IA analisa as informações coletadas e classifica automaticamente o nível de urgência do solicitante de acordo com os critérios definidos pelo estabelecimento, em segundos.</p>
      </div>

      <div class="home-feature-card">
        <div class="home-feature-card__icon home-feature-card__icon--teal">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <h3 class="home-feature-card__title">Validação pela Equipe</h3>
        <p class="home-feature-card__desc">Analistas revisam e confirmam (ou ajustam) a classificação da IA antes de inserir o solicitante na fila, garantindo segurança no processo.</p>
      </div>

      <div class="home-feature-card">
        <div class="home-feature-card__icon home-feature-card__icon--green">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"/>
            <line x1="8" y1="12" x2="21" y2="12"/>
            <line x1="8" y1="18" x2="21" y2="18"/>
            <line x1="3" y1="6" x2="3.01" y2="6"/>
            <line x1="3" y1="12" x2="3.01" y2="12"/>
            <line x1="3" y1="18" x2="3.01" y2="18"/>
          </svg>
        </div>
        <h3 class="home-feature-card__title">Fila Priorizada em Tempo Real</h3>
        <p class="home-feature-card__desc">A fila é ordenada automaticamente por urgência. Solicitantes acompanham sua posição em tempo real via app, e a TV exibe as chamadas ao vivo.</p>
      </div>

    </div>
  </section>

  <%# ── Como funciona ── %>
  <section class="home-steps-section">
    <div class="home-section-header">
      <p class="home-section__label">Como funciona</p>
      <h2 class="home-section__title">Quatro etapas, do contato ao atendimento</h2>
    </div>

    <div class="home-steps">
      <div class="home-step">
        <div class="home-step__number">1</div>
        <div class="home-step__content">
          <h3 class="home-step__title">Solicitante inicia a triagem</h3>
          <p class="home-step__desc">O solicitante acessa o sistema, cria uma conta e descreve sua necessidade inicial. A IA conduz uma conversa guiada para coletar todos os detalhes relevantes.</p>
        </div>
      </div>
      <div class="home-steps__connector" aria-hidden="true"></div>
      <div class="home-step">
        <div class="home-step__number">2</div>
        <div class="home-step__content">
          <h3 class="home-step__title">IA classifica a urgência</h3>
          <p class="home-step__desc">Ao finalizar o chat, o sistema analisa a transcrição completa e gera automaticamente uma classificação de urgência com resumo e justificativa estruturada.</p>
        </div>
      </div>
      <div class="home-steps__connector" aria-hidden="true"></div>
      <div class="home-step">
        <div class="home-step__number">3</div>
        <div class="home-step__content">
          <h3 class="home-step__title">Analista valida e insere na fila</h3>
          <p class="home-step__desc">O analista revisa a classificação da IA, pode ajustá-la se necessário, e confirma a entrada do solicitante na fila de espera priorizada.</p>
        </div>
      </div>
      <div class="home-steps__connector" aria-hidden="true"></div>
      <div class="home-step">
        <div class="home-step__number">4</div>
        <div class="home-step__content">
          <h3 class="home-step__title">Especialista realiza o atendimento</h3>
          <p class="home-step__desc">O especialista chama o próximo da fila, acessa o histórico completo do chat e a análise da IA, e registra a conclusão do atendimento.</p>
        </div>
      </div>
    </div>
  </section>

  <%# ── Acesso ── %>
  <section class="home-access-section">
    <div class="home-section-header">
      <p class="home-section__label">Acesse agora</p>
      <h2 class="home-section__title">Escolha seu perfil de acesso</h2>
    </div>

    <div class="home-access-cards">

      <div class="home-access-card home-access-card--patient">
        <div class="home-access-card__visual">
          <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
            <circle cx="28" cy="28" r="28" fill="#EBF8FF"/>
            <circle cx="28" cy="22" r="8" fill="#3182CE" opacity="0.85"/>
            <path d="M12 46c0-8.837 7.163-16 16-16s16 7.163 16 16" stroke="#3182CE" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="home-access-card__body">
          <h2 class="home-access-card__title"><%= t("app.home.patient_title") %></h2>
          <p class="home-access-card__desc"><%= t("app.home.patient_desc") %></p>
          <ul class="home-access-card__bullets">
            <li>Chat guiado com assistente de IA</li>
            <li>Acompanhe sua posição na fila</li>
            <li>Receba notificação de chamada</li>
          </ul>
        </div>
        <div class="home-access-card__actions">
          <%= link_to t("app.home.patient_login"), new_user_session_path,
                class: "btn btn--primary btn--full btn--lg" %>
          <%= link_to t("app.home.patient_register"), new_user_registration_path,
                class: "btn btn--outline btn--full" %>
        </div>
      </div>

      <div class="home-access-card home-access-card--staff">
        <div class="home-access-card__visual">
          <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
            <circle cx="28" cy="28" r="28" fill="#F0FFF4"/>
            <circle cx="20" cy="22" r="7" fill="#38A169" opacity="0.85"/>
            <path d="M6 44c0-7.732 6.268-14 14-14s14 6.268 14 14" stroke="#38A169" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="37" cy="20" r="5" fill="#38A169" opacity="0.5"/>
            <path d="M30 42c0-3.866 3.134-7 7-7" stroke="#38A169" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
          </svg>
        </div>
        <div class="home-access-card__body">
          <h2 class="home-access-card__title"><%= t("app.home.staff_title") %></h2>
          <p class="home-access-card__desc"><%= t("app.home.staff_desc") %></p>
          <ul class="home-access-card__bullets">
            <li>Painel de validação de triagens</li>
            <li>Gestão de fila e chamadas</li>
            <li>Dashboard e histórico</li>
          </ul>
        </div>
        <div class="home-access-card__actions">
          <%= link_to t("app.home.staff_login"), new_staff_session_path,
                class: "btn btn--staff btn--full btn--lg" %>
        </div>
      </div>

    </div>
  </section>

  <%# ── Footer ── %>
  <footer class="home-footer">
    <div class="home-footer__brand">
      <%= image_tag "logo.svg", width: 24, height: 24, alt: "TriagemAI", style: "border-radius:5px;" %>
      <span>Triagem<strong>AI</strong></span>
    </div>
    <p class="home-footer__copy">Sistema de Triagem Inteligente — Projeto de TCC</p>
    <%= link_to "Painel TV (Fila)", queue_tv_path, class: "home-footer__link" %>
  </footer>

</div>
