<% content_for :title, "Gerenciar Equipe" %>

<div class="admin-users-page">

  <%# ── Cabeçalho: título + botão ── %>
  <div class="admin-users-header">
    <div class="admin-users-header__info">
      <h1 class="admin-users-header__title">Equipe Interna</h1>
      <p class="admin-users-header__subtitle">Colaboradores e especialistas com acesso ao sistema.</p>
    </div>
    <%= link_to new_admin_user_path, class: "btn btn--primary" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
      Novo Membro
    <% end %>
  </div>

  <%# ── Toolbar: stats + busca + tags ── %>
  <div class="admin-toolbar">
    <div class="admin-toolbar__left">
    <div class="admin-stats">
      <%= link_to admin_users_path(search: params[:search]), class: "admin-stat admin-stat--link #{"admin-stat--active" if params[:status].blank? && params[:role].blank?}" do %>
        <span class="admin-stat__value"><%= @total_count %></span>
        <span class="admin-stat__label">Todos</span>
      <% end %>

      <div class="admin-stat__sep"></div>

      <%= link_to admin_users_path(status: "active", role: params[:role], search: params[:search]), class: "admin-stat admin-stat--link #{"admin-stat--active admin-stat--active-green" if params[:status] == "active"}" do %>
        <span class="admin-stat__value admin-stat__value--green"><%= @active_count %></span>
        <span class="admin-stat__label">Ativos</span>
      <% end %>

      <div class="admin-stat__sep"></div>

      <%= link_to admin_users_path(status: "inactive", role: params[:role], search: params[:search]), class: "admin-stat admin-stat--link #{"admin-stat--active admin-stat--active-red" if params[:status] == "inactive"}" do %>
        <span class="admin-stat__value admin-stat__value--red"><%= @inactive_count %></span>
        <span class="admin-stat__label">Inativos</span>
      <% end %>

      <div class="admin-stat__sep"></div>

      <%= link_to admin_users_path(role: "colaborador", status: params[:status], search: params[:search]), class: "admin-stat admin-stat--link #{"admin-stat--active admin-stat--active-blue" if params[:role] == "colaborador"}" do %>
        <span class="admin-stat__value admin-stat__value--blue"><%= @colaborador_count %></span>
        <span class="admin-stat__label">Colaboradores</span>
      <% end %>

      <div class="admin-stat__sep"></div>

      <%= link_to admin_users_path(role: "specialist", status: params[:status], search: params[:search]), class: "admin-stat admin-stat--link #{"admin-stat--active admin-stat--active-teal" if params[:role] == "specialist"}" do %>
        <span class="admin-stat__value admin-stat__value--teal"><%= @specialist_count %></span>
        <span class="admin-stat__label">Especialistas</span>
      <% end %>
    </div>

    <% if params[:status].present? || params[:role].present? || params[:search].present? %>
      <div class="admin-filter-active">
        <% if params[:status] == "active" %>
          <span class="admin-filter-tag admin-filter-tag--green">Ativos</span>
        <% elsif params[:status] == "inactive" %>
          <span class="admin-filter-tag admin-filter-tag--red">Inativos</span>
        <% end %>
        <% if params[:role] == "colaborador" %>
          <span class="admin-filter-tag admin-filter-tag--blue">Colaboradores</span>
        <% elsif params[:role] == "specialist" %>
          <span class="admin-filter-tag admin-filter-tag--teal">Especialistas</span>
        <% end %>
        <% if params[:search].present? %>
          <span class="admin-filter-tag">"<%= params[:search] %>"</span>
        <% end %>
        <%= link_to "Limpar filtros", admin_users_path, class: "admin-filter-clear" %>
      </div>
    <% end %>
    </div><%# /admin-toolbar__left %>

    <%= form_with url: admin_users_path, method: :get, local: true, class: "admin-search-form" do |f| %>
      <%= f.hidden_field :status, value: params[:status] %>
      <%= f.hidden_field :role,   value: params[:role] %>
      <div class="admin-search-input-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="admin-search-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"/></svg>
        <%= f.text_field :search, value: params[:search],
              placeholder: "Buscar por nome ou e-mail…",
              class: "admin-search-input",
              autocomplete: "off" %>
        <% if params[:search].present? %>
          <%= link_to admin_users_path(status: params[:status], role: params[:role]), class: "admin-search-clear", title: "Limpar busca" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          <% end %>
        <% end %>
      </div>
    <% end %>

  </div>

  <% if @staff.any? %>
    <%# ── Tabela ── %>
    <div class="admin-card">
      <div class="admin-card__meta">
        <span>
          <% if params[:status].present? || params[:role].present? || params[:search].present? %>
            <%= @pagy.count %> resultado<%= @pagy.count == 1 ? "" : "s" %> encontrado<%= @pagy.count == 1 ? "" : "s" %>
          <% else %>
            <%= @pagy.count %> membro<%= @pagy.count == 1 ? "" : "s" %>
          <% end %>
        </span>
        <% if @pagy.pages > 1 %>
          <span>Página <%= @pagy.page %> de <%= @pagy.pages %></span>
        <% end %>
      </div>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Membro</th>
            <th>Cargo</th>
            <th>Perfil</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @staff.each do |user| %>
            <tr class="admin-table__row">
              <td>
                <div class="admin-user-cell">
                  <div class="admin-user-avatar <%= user.specialist? && user.colaborador? ? "admin-user-avatar--both" : user.specialist? ? "admin-user-avatar--specialist" : "admin-user-avatar--colaborador" %>">
                    <% if user.avatar.attached? %>
                      <%= image_tag url_for(user.avatar), class: "admin-user-avatar__img", alt: user.name %>
                    <% else %>
                      <%= user.name.split.map(&:first).first(2).join.upcase %>
                    <% end %>
                  </div>
                  <div class="admin-user-cell__info">
                    <span class="admin-user-cell__name"><%= user.name %></span>
                    <span class="admin-user-cell__email"><%= user.email %></span>
                  </div>
                </div>
              </td>
              <td class="admin-table__cargo"><%= user.job_title.presence || "—" %></td>
              <td>
                <div class="admin-role-badges">
                  <% if user.colaborador? %>
                    <span class="role-badge role-badge--colaborador">Colaborador</span>
                  <% end %>
                  <% if user.specialist? %>
                    <span class="role-badge role-badge--specialist">Especialista</span>
                  <% end %>
                </div>
              </td>
              <td>
                <span class="status-pill <%= user.active? ? "status-pill--active" : "status-pill--inactive" %>">
                  <span class="status-pill__dot"></span>
                  <%= user.active? ? "Ativo" : "Inativo" %>
                </span>
              </td>
              <td class="admin-table__actions">
                <%= link_to edit_admin_user_path(user), class: "admin-action admin-action--edit" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.415.586H9v-2.414a2 2 0 01.586-1.414z"/></svg>
                  Editar
                <% end %>
                <% if @participant_ids.include?(user.id) %>
                  <span class="admin-action admin-action--locked"
                        title="Já participou de atendimentos e não pode ser excluído(a). Para remover o acesso, desative em Editar.">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path stroke-linecap="round" d="M8 11V7a4 4 0 018 0v4"/></svg>
                    Protegido
                  </span>
                <% else %>
                  <%= button_to admin_user_path(user), method: :delete,
                        class: "admin-action admin-action--delete",
                        form: { data: { turbo_confirm: "Remover #{user.name} da equipe?" } } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m-7 0a1 1 0 01-1-1V5a1 1 0 011-1h8a1 1 0 011 1v1a1 1 0 01-1 1H9z"/></svg>
                    Remover
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @pagy.pages > 1 %>
        <div class="admin-pagination">
          <% if @pagy.previous %>
            <%= link_to admin_users_path(page: @pagy.previous, status: params[:status], role: params[:role], search: params[:search], limit: @limit), class: "admin-page-btn" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              Anterior
            <% end %>
          <% end %>
          <span class="admin-pagination__info">Página <strong><%= @pagy.page %></strong> de <strong><%= @pagy.pages %></strong></span>
          <% if @pagy.next %>
            <%= link_to admin_users_path(page: @pagy.next, status: params[:status], role: params[:role], search: params[:search], limit: @limit), class: "admin-page-btn" do %>
              Próxima
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

  <% else %>
    <div class="admin-empty-state">
      <div class="admin-empty-state__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="#a0aec0" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
      <% if params[:status].present? || params[:search].present? %>
        <p class="admin-empty-state__title">Nenhum resultado encontrado</p>
        <p class="admin-empty-state__desc">Tente ajustar os filtros ou a busca.</p>
        <%= link_to "Limpar filtros", admin_users_path, class: "btn btn--secondary" %>
      <% else %>
        <p class="admin-empty-state__title">Nenhum membro cadastrado</p>
        <p class="admin-empty-state__desc">Adicione colaboradores e especialistas para começar.</p>
        <%= link_to "Adicionar primeiro membro", new_admin_user_path, class: "btn btn--primary" %>
      <% end %>
    </div>
  <% end %>

</div>
