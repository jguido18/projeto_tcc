<% content_for :title, t("devise.passwords.edit.title") %>

<div class="auth-page auth-page--center">
  <div class="auth-card">

    <div class="auth-card__header">
      <div class="auth-card__icon auth-card__icon--patient">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <h1 class="auth-card__title"><%= t("devise.passwords.edit.title") %></h1>
      <p class="auth-card__subtitle"><%= t("devise.passwords.edit.subtitle") %></p>
    </div>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name),
          html: { method: :put, class: "auth-form" }) do |f| %>

      <%= f.hidden_field :reset_password_token %>

      <div class="auth-field">
        <%= f.label :password, t("devise.passwords.edit.new_password"), class: "auth-label" %>
        <% if @minimum_password_length %>
          <span class="auth-hint">Mínimo <%= @minimum_password_length %> caracteres</span>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "auth-input", placeholder: "••••••••" %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, t("devise.passwords.edit.confirm_password"), class: "auth-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "auth-input", placeholder: "••••••••" %>
      </div>

      <div class="auth-actions">
        <%= f.submit t("devise.passwords.edit.submit"), class: "btn btn--primary btn--full btn--lg" %>
      </div>

    <% end %>

    <div class="auth-card__footer">
      <%= link_to "← #{t("app.home.back")}", root_path, class: "auth-link auth-link--muted" %>
    </div>

  </div>
</div>
