<% content_for :title, "#{t('app.doctor.title')} — #{@patient.name}" %>

<div class="attendance-page">

  <%# ── Cabeçalho do paciente ── %>
  <div class="attendance-hero attendance-hero--<%= @ai&.urgency_level || "blue" %>">
    <div class="attendance-hero__left">
      <div class="attendance-hero__ticket"><%= @queue_entry.ticket_number %></div>
      <div>
        <div class="attendance-hero__name"><%= @patient.name %></div>
        <div class="attendance-hero__complaint"><%= @session.chief_complaint %></div>
      </div>
    </div>
    <div class="attendance-hero__right">
      <span class="urgency-badge urgency-bg--<%= @ai&.urgency_level || "blue" %>">
        <%= @ai&.urgency_label || "—" %>
      </span>
      <% if @validation %>
        <% if @validation.final_urgency_level != @ai&.urgency_level %>
          <span class="attendance-adjusted-badge">
            ↳ <%= t("enums.triage_validation.final_urgency_level.#{@validation.final_urgency_level}") %>
            (<%= t("enums.triage_validation.decision.adjusted") %>)
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="attendance-body">

    <%# ── Coluna esquerda: dados da IA ── %>
    <aside class="attendance-sidebar">

      <div class="attendance-section">
        <div class="attendance-section__title"><%= t("app.doctor.chief_complaint") %></div>
        <div class="attendance-section__content"><%= @session.chief_complaint %></div>
      </div>

      <% if @ai %>
        <div class="attendance-section">
          <div class="attendance-section__title"><%= t("app.doctor.ai_suggestion") %></div>
          <div class="attendance-section__content">
            <span class="urgency-chip urgency-chip--<%= @ai.urgency_level %>">
              <%= @ai.urgency_label %>
            </span>
            <% if @ai.manchester_code.present? %>
              <span class="attendance-manchester"><%= @ai.manchester_code %></span>
            <% end %>
          </div>
        </div>

        <div class="attendance-section">
          <div class="attendance-section__title"><%= t("app.doctor.triage_summary") %></div>
          <div class="attendance-section__content"><%= @ai.summary %></div>
        </div>

        <% if @ai.clinical_reasoning.present? %>
          <div class="attendance-section">
            <div class="attendance-section__title"><%= t("app.doctor.ai_reasoning") %></div>
            <div class="attendance-section__content"><%= @ai.clinical_reasoning %></div>
          </div>
        <% end %>

        <% if @ai.identified_symptoms.present? %>
          <div class="attendance-section">
            <div class="attendance-section__title">
              <%= t("activerecord.attributes.ai_classification.identified_symptoms") %>
            </div>
            <div class="attendance-section__content attendance-section__content--symptoms">
              <% Array(@ai.identified_symptoms).each do |symptom| %>
                <span class="symptom-tag"><%= symptom %></span>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @ai.specialty_suggestion.present? %>
          <div class="attendance-section">
            <div class="attendance-section__title">
              <%= t("activerecord.attributes.ai_classification.specialty_suggestion") %>
            </div>
            <div class="attendance-section__content"><%= @ai.specialty_suggestion %></div>
          </div>
        <% end %>
      <% end %>

      <% if @validation&.notes.present? %>
        <div class="attendance-section attendance-section--nursing">
          <div class="attendance-section__title">
            <%= t("activerecord.attributes.triage_validation.notes") %> (enfermagem)
          </div>
          <div class="attendance-section__content"><%= @validation.notes %></div>
        </div>
      <% end %>

    </aside>

    <%# ── Coluna direita: transcrição do chat ── %>
    <main class="attendance-transcript">
      <div class="attendance-section__title"><%= t("app.doctor.triage_transcript") %></div>

      <div class="transcript-messages">
        <% @messages.each do |msg| %>
          <div class="transcript-msg transcript-msg--<%= msg.sender %>">
            <div class="transcript-msg__header">
              <span class="transcript-msg__sender">
                <%= msg.ai? ? t("app.triage.chat.title") : @patient.name %>
              </span>
              <span class="transcript-msg__time">
                <%= l(msg.sent_at, format: :short) %>
              </span>
            </div>
            <div class="transcript-msg__content"><%= msg.content %></div>
          </div>
        <% end %>
      </div>

      <%# ── Ações ── %>
      <div class="attendance-actions">
        <%= link_to t("app.doctor.back_to_panel"), doctor_root_path, class: "btn btn--secondary" %>

        <%= button_to t("app.doctor.finish_button"),
              finish_doctor_attendance_path(@queue_entry),
              method: :patch,
              class: "btn btn--finish",
              data: { turbo_confirm: t("app.doctor.finish_confirm") } %>
      </div>
    </main>

  </div>
</div>
