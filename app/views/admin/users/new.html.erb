<% content_for :title, "Novo Membro da Equipe" %>

<div class="triage-settings-page">
  <div class="triage-settings-header">
    <h1>Novo Membro da Equipe</h1>
    <p>Crie um colaborador (validação) ou especialista (atendimento).</p>
  </div>

  <%= form_with model: [:admin, @user], class: "triage-settings-form" do |f| %>
    <%= render "form", user: @user, f: f %>
  <% end %>
</div>
