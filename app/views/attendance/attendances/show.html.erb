<% content_for :title, "#{t('app.attendance.title')} — #{@patient.name}" %>

<div class="attendance-page">

  <% ai_level = @ai&.urgency_level %>
  <% final_level = @validation&.final_urgency_level || ai_level %>

  <%# ── Cabeçalho do paciente ── %>
  <div class="attendance-hero" style="border-left: 6px solid <%= urgency_color(final_level) %>;">
    <div class="attendance-hero__left">
      <div class="attendance-hero__ticket"><%= @queue_entry.ticket_number %></div>
      <div>
        <div class="attendance-hero__name"><%= @patient.name %></div>
        <div class="attendance-hero__complaint"><%= @session.initial_demand %></div>
      </div>
    </div>
    <div class="attendance-hero__right">
      <span class="urgency-badge" style="<%= urgency_badge_style(final_level) %>">
        <%= urgency_label(final_level) %>
      </span>
      <% if @queue_entry.priority_tier > 0 %>
        <% reason_labels = @queue_entry.priority_reasons.map { |r| User::PRIORITY_REASON_LABELS[r.to_sym] }.join(", ") %>
        <span class="attendance-priority-badge <%= "attendance-priority-badge--super" if @queue_entry.priority_tier == 2 %>" title="<%= reason_labels %> (Lei 10.048/2000)">
          ★ <%= reason_labels %>
        </span>
      <% end %>
      <% if @validation %>
        <% if @validation.final_urgency_level != ai_level %>
          <span class="attendance-adjusted-badge">
            ↳ <%= urgency_label(@validation.final_urgency_level) %>
            (<%= t("enums.triage_validation.decision.adjusted") %>)
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="attendance-body">

    <%# ── Coluna esquerda: dados da IA ── %>
    <aside class="attendance-sidebar">

      <div class="attendance-section">
        <div class="attendance-section__title"><%= t("app.attendance.initial_demand") %></div>
        <div class="attendance-section__content"><%= @session.initial_demand %></div>
      </div>

      <div class="attendance-section">
        <div class="attendance-section__title">Início da triagem</div>
        <div class="attendance-section__content attendance-section__content--meta">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="13" height="13" style="flex-shrink:0;opacity:0.6;">
            <path fill-rule="evenodd" d="M1 8a7 7 0 1 1 14 0A7 7 0 0 1 1 8Zm7.75-4.25a.75.75 0 0 0-1.5 0V8c0 .414.336.75.75.75h3.25a.75.75 0 0 0 0-1.5h-2.5v-3.5Z" clip-rule="evenodd"/>
          </svg>
          <%= l(@session.created_at, format: :long) %>
        </div>
      </div>

      <% if @ai %>
        <div class="attendance-section">
          <div class="attendance-section__title"><%= t("app.attendance.ai_suggestion") %></div>
          <div class="attendance-section__content">
            <span class="urgency-chip" style="<%= urgency_badge_style(@ai.urgency_level) %>">
              <%= @ai.urgency_label %>
            </span>
            <% if @ai.protocol_reference.present? %>
              <span class="attendance-manchester"><%= @ai.protocol_reference %></span>
            <% end %>
          </div>
        </div>

        <div class="attendance-section">
          <div class="attendance-section__title"><%= t("app.attendance.triage_summary") %></div>
          <div class="attendance-section__content"><%= @ai.summary %></div>
        </div>

        <% if @ai.classification_reasoning.present? %>
          <div class="attendance-section">
            <div class="attendance-section__title"><%= t("app.attendance.classification_reasoning") %></div>
            <div class="attendance-section__content"><%= @ai.classification_reasoning %></div>
          </div>
        <% end %>

        <% if @ai.identified_symptoms.present? %>
          <div class="attendance-section">
            <div class="attendance-section__title">
              <%= t("activerecord.attributes.ai_classification.identified_symptoms") %>
            </div>
            <div class="attendance-section__content attendance-section__content--symptoms">
              <% Array(@ai.identified_symptoms).each do |symptom| %>
                <span class="symptom-tag"><%= symptom %></span>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @ai.routing_suggestion.present? %>
          <div class="attendance-section">
            <div class="attendance-section__title">
              <%= t("activerecord.attributes.ai_classification.routing_suggestion") %>
            </div>
            <div class="attendance-section__content"><%= @ai.routing_suggestion %></div>
          </div>
        <% end %>
      <% end %>

      <% if @can_review_classification %>
        <div class="attendance-section attendance-section--review">
          <div class="attendance-section__title">Avaliar classificação da IA</div>
          <p class="attendance-review__hint">
            Esta triagem entrou na fila sem validação da equipe. Confirme ou ajuste a classificação da IA —
            não muda a fila, mas alimenta o relatório de precisão da IA.
          </p>

          <%= form_with url: review_classification_attendance_attendance_path(@queue_entry), scope: :triage_validation, method: :post, class: "attendance-review__form" do |f| %>
            <div class="urgency-selector">
              <% @urgency_levels.each do |level| %>
                <label class="urgency-option" style="border-color:<%= level['color'] %>;">
                  <%= f.radio_button :final_urgency_level, level["key"], checked: level["key"] == @ai.urgency_level %>
                  <span class="urgency-option__label" style="color:<%= level['color'] %>"><%= level["label"] %></span>
                </label>
              <% end %>
            </div>
            <%= f.text_area :notes, rows: 2, class: "validation-textarea", placeholder: "Observação (obrigatória se ajustar a classificação)" %>
            <%= f.submit "Registrar avaliação", class: "btn btn--primary btn--full" %>
          <% end %>
        </div>
      <% end %>

      <% if @validation&.notes.present? %>
        <div class="attendance-section attendance-section--colaborador">
          <div class="attendance-section__title">
            <%= t("activerecord.attributes.triage_validation.notes") %> (equipe)
          </div>
          <div class="attendance-section__content"><%= @validation.notes %></div>
        </div>
      <% end %>

      <% if @documents.any? %>
        <div class="attendance-section">
          <div class="attendance-section__title">Documentos Anexados</div>
          <div class="attendance-section__content">
            <% @documents.each do |doc| %>
              <div class="doc-item">
                <div class="doc-item__info">
                  <span class="doc-item__icon">
                    <% if doc.image? %>📷<% else %>📄<% end %>
                  </span>
                  <div>
                    <div class="doc-item__name"><%= doc.original_filename %></div>
                    <div class="doc-item__meta">
                      <%= doc.document_type_label %>
                      <span class="doc-badge doc-badge--<%= doc.validation_status %>">
                        <%= { "valid" => "✓ Válido", "invalid" => "✗ Inválido", "uncertain" => "? Incerto", "pending" => "⏳ Pendente", "skipped" => "— Sem validação" }[doc.validation_status] || doc.validation_status %>
                      </span>
                    </div>
                    <% if doc.validation_result&.dig("summary").present? %>
                      <div class="doc-item__summary"><%= doc.validation_result["summary"] %></div>
                    <% end %>
                  </div>
                </div>
                <% if doc.file.attached? %>
                  <%= link_to "Baixar",
                        rails_blob_path(doc.file, disposition: "attachment"),
                        class: "btn btn--doc-download",
                        target: "_blank" %>
                  <% if doc.image? %>
                    <%= link_to "Ver",
                          rails_blob_path(doc.file, disposition: "inline"),
                          class: "btn btn--doc-view",
                          target: "_blank" %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </aside>

    <%# ── Coluna direita: transcrição do chat ── %>
    <main class="attendance-transcript">
      <div class="attendance-section__title"><%= t("app.attendance.triage_transcript") %></div>

      <div class="transcript-messages">
        <% @messages.each do |msg| %>
          <div class="transcript-msg transcript-msg--<%= msg.sender %>">
            <div class="transcript-msg__header">
              <span class="transcript-msg__sender">
                <%= msg.ai? ? t("app.triage.chat.title") : @patient.name %>
              </span>
              <span class="transcript-msg__time">
                <%= l(msg.sent_at, format: :short) %>
              </span>
            </div>
            <div class="transcript-msg__content"><%= msg.content %></div>
          </div>
        <% end %>
      </div>

      <%# ── Ações ── %>
      <div class="attendance-actions">
          <%= link_to t("app.attendance.back_to_panel"), attendance_root_path, class: "btn btn--secondary" %>

          <% if @queue_entry.called? %>
            <%= button_to t("app.attendance.finish_button"),
              finish_attendance_attendance_path(@queue_entry),
                method: :patch,
                class: "btn btn--finish",
              data: { turbo_confirm: t("app.attendance.finish_confirm") } %>
          <% end %>
      </div>
    </main>

  </div>
</div>
