<% content_for :title, t("app.nursing.title") %>

<div class="nursing-panel-toolbar">
  <%= link_to t("app.reports.title"), nursing_reports_path, class: "btn btn--secondary" %>
</div>

<div class="nursing-panel"
     data-controller="nursing-panel"
     data-nursing-panel-establishment-id-value="<%= current_establishment.id %>">

  <%# ── Left column: awaiting nursing validation ── %>
  <section class="nursing-column nursing-column--validation">
    <div class="nursing-column__header nursing-column__header--yellow">
      <h2 class="nursing-column__title"><%= t("app.nursing.awaiting_validation") %></h2>
      <span class="nursing-column__badge" data-nursing-panel-target="awaitingCount">
        <%= @awaiting_validation.count %>
      </span>
    </div>

    <div class="nursing-column__body" data-nursing-panel-target="awaitingList">
      <% if @awaiting_validation.empty? %>
        <p class="nursing-empty"><%= t("app.nursing.no_pending") %></p>
      <% else %>
        <% @awaiting_validation.each do |session| %>
          <% classification = session.ai_classification %>
          <div class="nursing-card nursing-card--<%= classification&.urgency_level || "blue" %>">
            <div class="nursing-card__top">
              <div class="nursing-card__urgency-badge urgency-bg--<%= classification&.urgency_level || "blue" %>">
                <%= classification&.urgency_label || "—" %>
              </div>
              <span class="nursing-card__time">
                <%= t("app.nursing.arrived_at") %>: <%= l(session.created_at, format: :short) %>
              </span>
            </div>

            <div class="nursing-card__name"><%= session.user.name %></div>
            <div class="nursing-card__complaint"><%= session.chief_complaint %></div>

            <% if classification&.summary.present? %>
              <div class="nursing-card__summary"><%= classification.summary.truncate(120) %></div>
            <% end %>

            <%= link_to t("app.nursing.validate_button"),
                  new_nursing_triage_validation_path(triage_session_id: session.id),
                  class: "nursing-card__action nursing-card__action--validate" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <%# ── Right column: validated sessions waiting in queue ── %>
  <section class="nursing-column nursing-column--queue">
    <div class="nursing-column__header nursing-column__header--green">
      <h2 class="nursing-column__title"><%= t("app.nursing.priority_queue") %></h2>
      <span class="nursing-column__badge" data-nursing-panel-target="queueCount">
        <%= @total_waiting %>
      </span>
    </div>

    <div class="nursing-column__body" data-nursing-panel-target="queueList">
      <% if @priority_queue.empty? %>
        <p class="nursing-empty"><%= t("app.nursing.queue_empty") %></p>
      <% else %>
        <% @priority_queue.each_with_index do |entry, idx| %>
          <% session     = entry.triage_session %>
          <% validation  = session.ai_classification&.triage_validation %>
          <% final_level = validation&.final_urgency_level || session.ai_classification&.urgency_level || "blue" %>
          <% final_label = AiClassification::URGENCY_LABELS[final_level] || "—" %>

          <div class="nursing-card nursing-card--<%= final_level %>">
            <div class="nursing-card__top">
              <span class="nursing-card__position">#<%= idx + 1 %></span>
              <div class="nursing-card__urgency-badge urgency-bg--<%= final_level %>">
                <%= final_label %>
              </div>
              <span class="nursing-card__ticket"><%= entry.ticket_number %></span>
            </div>

            <div class="nursing-card__name"><%= session.user.name %></div>
            <div class="nursing-card__complaint"><%= session.chief_complaint %></div>

            <div class="nursing-card__meta">
              <%= t("app.nursing.arrived_at") %>: <%= l(entry.queued_at, format: :short) %>
            </div>

            <%= button_to t("app.nursing.call_button"),
                  call_nursing_queue_entry_path(entry),
                  method: :patch,
                  class: "nursing-card__action nursing-card__action--call" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

</div>
