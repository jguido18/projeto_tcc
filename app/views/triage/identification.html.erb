<% content_for :title, "Início da Triagem — TriagemAI" %>

<div class="triage-identification">
  <div class="identification-card">
    <div class="identification-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
    </div>

    <h1>Início da Triagem</h1>
    <p>Descreva sua necessidade para iniciar o atendimento.</p>

    <%= form_with url: triage_start_path, method: :post, data: { turbo: false } do |f| %>
      <div class="field">
          <%= f.label :initial_demand, "Qual é a sua necessidade inicial?" %>
          <%= f.text_area :initial_demand,
            placeholder: "Descreva brevemente o motivo do atendimento...",
              required: true,
              rows: 3,
              autofocus: true %>
      </div>

      <%= f.submit "Iniciar Triagem", class: "btn-primary" %>
    <% end %>
  </div>
</div>
