<% content_for :title, t("app.doctor.title") %>

<div class="doctor-panel">
  <div class="doctor-panel__header">
    <div>
      <h1 class="doctor-panel__title"><%= t("app.doctor.title") %></h1>
      <p class="doctor-panel__subtitle"><%= t("app.doctor.subtitle") %></p>
    </div>
    <div class="doctor-panel__stats">
      <div class="doctor-stat">
        <span class="doctor-stat__value"><%= @called_entries.count %></span>
        <span class="doctor-stat__label"><%= t("app.doctor.waiting_count") %></span>
      </div>
    </div>
  </div>

  <% if @called_entries.empty? %>
    <div class="doctor-empty">
      <div class="doctor-empty__icon">✓</div>
      <p class="doctor-empty__text"><%= t("app.doctor.no_patients") %></p>
    </div>
  <% else %>
    <div class="doctor-cards">
      <% @called_entries.each_with_index do |entry, idx| %>
        <% session    = entry.triage_session %>
        <% patient    = session.user %>
        <% ai         = session.ai_classification %>
        <% validation = ai&.triage_validation %>
        <% final_level = validation&.final_urgency_level || ai&.urgency_level || "blue" %>
        <% final_label = AiClassification::URGENCY_LABELS[final_level] || "—" %>

        <div class="doctor-card doctor-card--<%= final_level %>">
          <div class="doctor-card__top">
            <span class="doctor-card__order">#<%= idx + 1 %></span>
            <span class="urgency-badge urgency-bg--<%= final_level %>"><%= final_label %></span>
            <span class="doctor-card__ticket"><%= entry.ticket_number %></span>
            <span class="doctor-card__called-at">
              <%= t("app.doctor.called_at") %>: <%= l(entry.called_at, format: :short) %>
            </span>
          </div>

          <div class="doctor-card__name"><%= patient.name %></div>
          <div class="doctor-card__complaint"><%= session.chief_complaint %></div>

          <% if ai&.summary.present? %>
            <div class="doctor-card__summary"><%= ai.summary.truncate(150) %></div>
          <% end %>

          <%= link_to t("app.doctor.see_details"),
                doctor_attendance_path(entry),
                class: "doctor-card__action" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
