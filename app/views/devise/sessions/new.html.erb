<% content_for :title, t("devise.sessions.new.title") %>

<div class="auth-page auth-page--center">
  <div class="auth-card">

    <div class="auth-card__header">
      <div class="auth-card__icon auth-card__icon--patient">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </div>
      <h1 class="auth-card__title"><%= t("devise.sessions.new.title") %></h1>
      <p class="auth-card__subtitle"><%= t("devise.sessions.new.subtitle") %></p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name),
          html: { class: "auth-form" }) do |f| %>

      <div class="auth-field">
        <%= f.label :email, t("activerecord.attributes.user.email"), class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "auth-input", placeholder: "seu@email.com" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, t("activerecord.attributes.user.password"), class: "auth-label" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "auth-input", placeholder: "••••••••" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="auth-field auth-field--inline">
          <%= f.check_box :remember_me, class: "auth-checkbox" %>
          <%= f.label :remember_me, t("devise.sessions.new.remember_me"), class: "auth-label auth-label--inline" %>
        </div>
      <% end %>

      <div class="auth-actions">
        <%= f.submit t("devise.sessions.new.submit"), class: "btn btn--primary btn--full btn--lg" %>
      </div>

    <% end %>

    <div class="auth-links">
      <%= link_to t("devise.shared.links.sign_up"), new_user_registration_path, class: "auth-link" %>
      <span class="auth-links__sep">·</span>
      <%= link_to t("devise.shared.links.forgot_password"), new_user_password_path, class: "auth-link" %>
    </div>

    <div class="auth-card__footer">
      <%= link_to "← #{t("app.home.back")}", root_path, class: "auth-link auth-link--muted" %>
    </div>

  </div>
</div>
