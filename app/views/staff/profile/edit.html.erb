<% content_for :title, "Meu Perfil" %>

<div class="validation-header">
  <h1 class="validation-title">Meu perfil</h1>
</div>

<% if flash[:notice] %>
  <div class="validation-notice"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="validation-errors"><ul><li><%= flash[:alert] %></li></ul></div>
<% end %>

<%= form_with model: current_user, url: staff_profile_path, method: :patch,
      html: { enctype: "multipart/form-data" } do |f| %>

  <%# Foto de perfil %>
  <section class="triage-settings-card">
    <h2>Foto de perfil</h2>
    <div style="display:flex; align-items:center; gap:20px;">
      <% if current_user.avatar.attached? && current_user.avatar.blob.persisted? %>
        <%= image_tag current_user.avatar, style: "width:80px; height:80px; border-radius:50%; object-fit:cover; border:3px solid #e2e8f0;" %>
      <% else %>
        <div style="width:80px; height:80px; border-radius:50%; background:#e2e8f0; display:flex; align-items:center; justify-content:center; font-size:2rem; color:#a0aec0;">&#9679;</div>
      <% end %>
      <div>
        <%= f.label :avatar, "Alterar foto", class: "btn btn--secondary", style: "cursor:pointer;" %>
        <%= f.file_field :avatar, accept: "image/*", style: "display:none;",
              onchange: "document.getElementById('avatar-name').textContent = this.files[0]?.name || ''" %>
        <p id="avatar-name" style="margin-top:4px; font-size:0.8rem; color:#718096;"></p>
      </div>
    </div>
  </section>

  <%# Dados pessoais %>
  <section class="triage-settings-card">
    <h2>Dados pessoais</h2>
    <div class="urgency-level-row__grid">
      <div class="validation-field">
        <%= f.label :name, "Nome completo", class: "validation-label" %>
        <%= f.text_field :name, class: "validation-textarea", placeholder: "Nome completo" %>
      </div>
      <div class="validation-field">
        <%= f.label :cpf, "CPF", class: "validation-label" %>
        <%= f.text_field :cpf, class: "validation-textarea", placeholder: "000.000.000-00" %>
      </div>
      <div class="validation-field">
        <%= f.label :phone, "Telefone", class: "validation-label" %>
        <%= f.text_field :phone, class: "validation-textarea", placeholder: "(11) 99999-9999" %>
      </div>
      <div class="validation-field">
        <%= f.label :birth_date, "Data de nascimento", class: "validation-label" %>
        <%= f.date_field :birth_date, class: "validation-textarea" %>
      </div>
    </div>
  </section>

  <%# E-mail %>
  <section class="triage-settings-card">
    <h2>E-mail de acesso</h2>
    <div class="validation-field">
      <%= f.label :email, "E-mail", class: "validation-label" %>
      <%= f.email_field :email, class: "validation-textarea", placeholder: "email@exemplo.com",
            id: "email-field", oninput: "checkCredentialChange()" %>
    </div>
  </section>

  <%# Alterar senha — sempre visível, sem dropdown %>
  <section class="triage-settings-card">
    <h2>Alterar senha</h2>
    <p style="font-size:0.875rem; color:#718096; margin-bottom:12px;">Deixe em branco para manter a senha atual.</p>
    <div class="urgency-level-row__grid">
      <div class="validation-field">
        <%= f.label :password, "Nova senha", class: "validation-label" %>
        <%= f.password_field :password, class: "validation-textarea",
              autocomplete: "new-password", placeholder: "Mínimo 6 caracteres",
              id: "new-password-field", oninput: "checkCredentialChange()" %>
      </div>
      <div class="validation-field">
        <%= f.label :password_confirmation, "Confirmar nova senha", class: "validation-label" %>
        <%= f.password_field :password_confirmation, class: "validation-textarea",
              autocomplete: "new-password", placeholder: "Repita a nova senha" %>
      </div>
    </div>
  </section>

  <%# Senha atual — aparece ao alterar e-mail ou nova senha %>
  <section id="current-password-section" class="triage-settings-card"
           style="display:none; background:#fffbeb; border:1px solid #f6e05e;">
    <h2 style="color:#744210;">&#128274; Confirme sua senha atual</h2>
    <p style="font-size:0.875rem; color:#744210; margin-bottom:12px;">
      Para alterar e-mail ou senha é necessário informar sua senha atual.
    </p>
    <div class="validation-field">
      <%= f.label :current_password, "Senha atual", class: "validation-label" %>
      <%= f.password_field :current_password, class: "validation-textarea",
            autocomplete: "current-password", placeholder: "Sua senha atual" %>
    </div>
  </section>

  <div class="validation-actions">
    <%= f.submit "Salvar alterações", class: "btn btn--primary" %>
    <% back_path = current_user.specialist? ? attendance_root_path : validation_root_path %>
    <%= link_to "Voltar", back_path, class: "btn btn--secondary" %>
  </div>
<% end %>

<script>
  const originalEmail = "<%= j current_user.email %>"

  function checkCredentialChange() {
    const emailField = document.getElementById("email-field")
    const passwordField = document.getElementById("new-password-field")
    const currentSection = document.getElementById("current-password-section")
    const emailChanged = emailField && emailField.value !== originalEmail
    const passwordFilled = passwordField && passwordField.value.length > 0
    currentSection.style.display = (emailChanged || passwordFilled) ? "block" : "none"
  }
</script>
