<% content_for :title, "Editar Membro" %>

<div class="profile-page">
  <div class="profile-page__header">
    <div>
      <h1 class="profile-page__title">Editar Membro</h1>
      <p class="profile-page__subtitle"><%= @user.name %> — <%= @user.email %></p>
    </div>
  </div>

  <%= form_with model: [:admin, @user] do |f| %>
    <%= render "form", user: @user, f: f %>
  <% end %>
</div>
