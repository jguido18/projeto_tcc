<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.validation.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="colaborador-layout">
    <header class="colaborador-header">
      <%= link_to validation_root_path, class: "colaborador-header__brand app-header__logo-link" do %>
        <span class="app-header__logo-icon">+</span>
        <span class="app-header__logo-text">Triagem<strong>AI</strong></span>
      <% end %>

      <div class="colaborador-header__user">
        <span class="colaborador-header__name"><%= current_user.name %></span>
        <span class="colaborador-header__role"><%= t("enums.user.job_title.#{current_user.job_title}") if current_user.job_title.present? %></span>
        <% if current_user.admin? %>
          <%= link_to "Equipe", admin_users_path, class: "colaborador-header__logout" %>
          <%= link_to "Configuração IA", edit_admin_triage_setting_path, class: "colaborador-header__logout" %>
        <% end %>
        <%= link_to t("app.nav.logout"), destroy_user_session_path,
              data: { turbo_method: :delete },
              class: "colaborador-header__logout" %>
      </div>
    </header>

    <% if notice.present? %>
      <div class="flash flash--notice"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="flash flash--alert"><%= alert %></div>
    <% end %>

    <main class="colaborador-main">
      <%= yield %>
    </main>
  </body>
</html>
