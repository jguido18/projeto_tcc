<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.validation.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="colaborador-layout">
    <header class="colaborador-header">
      <%= link_to validation_root_path, class: "colaborador-header__brand app-header__logo-link" do %>
        <%= image_tag "logo.svg", width: 30, height: 30, alt: "TriagemAI", style: "border-radius:7px;" %>
        <span class="app-header__logo-text">Triagem<strong>AI</strong></span>
      <% end %>

      <div class="colaborador-header__user">
        <%= render "shared/staff_user_dropdown" %>
      </div>
    </header>

    <%= render "shared/toasts" %>

    <main class="colaborador-main">
      <%= yield %>
    </main>
  </body>
</html>
