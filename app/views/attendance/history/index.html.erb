<% content_for :title, "Histórico de Atendimentos" %>

<div class="panel-page-header">
  <div class="panel-page-header__left">
    <h1 class="panel-page-header__title">Histórico de Atendimentos</h1>
    <p class="panel-page-header__subtitle">Atendimentos finalizados — busque por nome, demanda ou período</p>
  </div>
  <div class="panel-page-header__stats">
    <div class="panel-stat panel-stat--blue">
      <span class="panel-stat__value"><%= @pagy.count %></span>
      <span class="panel-stat__label">Total encontrados</span>
    </div>
  </div>
</div>

<%# ── Filtros ── %>
<div class="history-filters">
  <%= form_with url: attendance_history_path, method: :get, local: true, html: { class: "history-filters__form" } do |f| %>

    <div class="history-filter-field">
      <%= f.label :patient_name, "Nome do paciente", class: "history-filter-label" %>
      <%= f.text_field :patient_name, value: params[:patient_name],
            class: "history-filter-input",
            placeholder: "Buscar por nome..." %>
    </div>

    <div class="history-filter-field">
      <%= f.label :demand, "Demanda / Título", class: "history-filter-label" %>
      <%= f.text_field :demand, value: params[:demand],
            class: "history-filter-input",
            placeholder: "Buscar na demanda inicial..." %>
    </div>

    <div class="history-filter-field">
      <%= f.label :date_from, "Data inicial", class: "history-filter-label" %>
      <%= f.date_field :date_from, value: params[:date_from], class: "history-filter-input" %>
    </div>

    <div class="history-filter-field">
      <%= f.label :date_to, "Data final", class: "history-filter-label" %>
      <%= f.date_field :date_to, value: params[:date_to], class: "history-filter-input" %>
    </div>

    <div class="history-filter-actions">
      <%= f.submit "Buscar", class: "btn btn--primary" %>
      <% if params.slice(:patient_name, :demand, :date_from, :date_to).values.any?(&:present?) %>
        <%= link_to "Limpar", attendance_history_path, class: "btn btn--secondary" %>
      <% end %>
    </div>

  <% end %>
</div>

<%# ── Tabela de resultados ── %>
<div class="history-card">
  <% if @entries.empty? %>
    <div class="panel-empty-state">
      <div class="panel-empty-state__icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </div>
      <p class="panel-empty-state__text">Nenhum atendimento encontrado</p>
      <p class="panel-empty-state__hint">Tente ajustar os filtros de busca.</p>
    </div>
  <% else %>
    <div class="history-table-wrap">
      <table class="history-table">
        <thead>
          <tr>
            <th>Senha</th>
            <th>Paciente</th>
            <th>Demanda inicial</th>
            <th>Urgência</th>
            <th>Finalizado em</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @entries.each do |entry| %>
            <% session = entry.triage_session %>
            <% patient = session.user %>
            <% ai = session.ai_classification %>
            <% validation = ai&.triage_validation %>
            <% final_level = validation&.final_urgency_level || ai&.urgency_level %>
            <tr class="history-row" style="border-left: 4px solid <%= urgency_color(final_level) %>;">
              <td class="history-row__ticket"><%= entry.ticket_number %></td>
              <td class="history-row__patient"><%= patient.name %></td>
              <td class="history-row__demand"><%= session.initial_demand&.truncate(80) %></td>
              <td>
                <span class="urgency-badge" style="<%= urgency_badge_style(final_level) %>">
                  <%= urgency_label(final_level) %>
                </span>
              </td>
              <td class="history-row__date">
                <% if entry.service_finished_at %>
                  <div><%= l(entry.service_finished_at, format: :short) %></div>
                  <div class="history-row__date-day"><%= l(entry.service_finished_at.to_date, format: :long) %></div>
                <% else %>
                  <span style="color:#a0aec0;">—</span>
                <% end %>
              </td>
              <td>
                <%= link_to "Ver detalhes", attendance_attendance_path(entry),
                      class: "history-row__link" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Paginação %>
    <% if @pagy.pages > 1 %>
      <div class="history-pagination">
        <span class="history-pagination__info">
          Página <%= @pagy.page %> de <%= @pagy.pages %>
          &nbsp;·&nbsp; <%= @pagy.count %> resultado<%= @pagy.count == 1 ? "" : "s" %>
        </span>
        <div class="history-pagination__controls">
          <% if @pagy.previous %>
            <%= link_to "← Anterior", attendance_history_path(params.permit(:patient_name, :demand, :date_from, :date_to).merge(page: @pagy.previous)), class: "btn btn--secondary btn--sm" %>
          <% end %>
          <% if @pagy.next %>
            <%= link_to "Próxima →", attendance_history_path(params.permit(:patient_name, :demand, :date_from, :date_to).merge(page: @pagy.next)), class: "btn btn--secondary btn--sm" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
