<% content_for :title, "Meu Perfil" %>

<div class="profile-page">

  <div class="profile-page__header">
    <div>
      <h1 class="profile-page__title">Meu perfil</h1>
      <p class="profile-page__subtitle">Gerencie suas informações pessoais e credenciais de acesso</p>
    </div>
  </div>

  <%= form_with model: current_user, url: staff_profile_path, method: :patch,
        html: { enctype: "multipart/form-data", class: "profile-card" } do |f| %>

    <%# ── Foto de perfil ── %>
    <div class="profile-section">
      <div class="profile-section__label">Foto de perfil</div>
      <div class="profile-avatar-row">
        <div class="profile-avatar-preview">
          <% if current_user.avatar.attached? && current_user.avatar.blob.persisted? %>
            <%= image_tag current_user.avatar, class: "profile-avatar-img" %>
          <% else %>
            <div class="profile-avatar-placeholder">
              <%= current_user.name&.first&.upcase || "?" %>
            </div>
          <% end %>
        </div>
        <div class="profile-avatar-controls">
          <%= f.label :avatar, class: "btn btn--secondary" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            Alterar foto
          <% end %>
          <%= f.file_field :avatar, accept: "image/*", style: "display:none;",
                onchange: "document.getElementById('avatar-filename').textContent = this.files[0]?.name || ''" %>
          <p id="avatar-filename" class="profile-avatar-filename"></p>
        </div>
      </div>
    </div>

    <div class="profile-divider"></div>

    <%# ── Dados pessoais ── %>
    <div class="profile-section">
      <div class="profile-section__label">Dados pessoais</div>
      <div class="profile-fields-grid">
        <div class="profile-field profile-field--wide">
          <%= f.label :name, "Nome completo", class: "profile-label" %>
          <%= f.text_field :name, class: "profile-input", placeholder: "Nome completo" %>
        </div>
        <div class="profile-field">
          <%= f.label :cpf, "CPF", class: "profile-label" %>
          <%= f.text_field :cpf, class: "profile-input", placeholder: "000.000.000-00" %>
        </div>
        <div class="profile-field">
          <%= f.label :phone, "Telefone", class: "profile-label" %>
          <%= f.text_field :phone, class: "profile-input", placeholder: "(11) 99999-9999" %>
        </div>
        <div class="profile-field">
          <%= f.label :birth_date, "Data de nascimento", class: "profile-label" %>
          <%= f.date_field :birth_date, class: "profile-input" %>
        </div>
      </div>
    </div>

    <div class="profile-divider"></div>

    <%# ── E-mail de acesso ── %>
    <div class="profile-section">
      <div class="profile-section__label">E-mail de acesso</div>
      <div class="profile-fields-grid">
        <div class="profile-field profile-field--wide">
          <%= f.label :email, "E-mail", class: "profile-label" %>
          <%= f.email_field :email, class: "profile-input", placeholder: "email@exemplo.com",
                id: "email-field", oninput: "checkCredentialChange()" %>
        </div>
      </div>
    </div>

    <div class="profile-divider"></div>

    <%# ── Alterar senha ── %>
    <div class="profile-section">
      <div class="profile-section__label">Alterar senha</div>
      <p class="profile-section__hint">Deixe em branco para manter a senha atual.</p>
      <div class="profile-fields-grid">
        <div class="profile-field">
          <%= f.label :password, "Nova senha", class: "profile-label" %>
          <%= f.password_field :password, class: "profile-input",
                autocomplete: "new-password", placeholder: "Mínimo 6 caracteres",
                id: "new-password-field", oninput: "checkCredentialChange()" %>
        </div>
        <div class="profile-field">
          <%= f.label :password_confirmation, "Confirmar nova senha", class: "profile-label" %>
          <%= f.password_field :password_confirmation, class: "profile-input",
                autocomplete: "new-password", placeholder: "Repita a nova senha" %>
        </div>
      </div>
    </div>

    <%# ── Senha atual (aparece ao alterar e-mail ou senha) ── %>
    <div id="current-password-section" style="display:none;">
      <div class="profile-divider"></div>
      <div class="profile-section profile-section--warning">
        <div class="profile-section__label profile-section__label--warning">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Confirme sua senha atual
        </div>
        <p class="profile-section__hint profile-section__hint--warning">
          Para alterar e-mail ou senha é necessário informar sua senha atual.
        </p>
        <div class="profile-fields-grid">
          <div class="profile-field">
            <%= f.label :current_password, "Senha atual", class: "profile-label" %>
            <%= f.password_field :current_password, class: "profile-input",
                  autocomplete: "current-password", placeholder: "Sua senha atual" %>
          </div>
        </div>
      </div>
    </div>

    <%# ── Ações ── %>
    <div class="profile-divider"></div>
    <div class="profile-actions">
      <%= f.submit "Salvar alterações", class: "btn btn--primary" %>
      <% back_path = current_user.specialist? ? attendance_root_path : validation_root_path %>
      <%= link_to "← Voltar", back_path, class: "btn btn--secondary" %>
    </div>

  <% end %>

</div>

<script>
  const originalEmail = "<%= j current_user.email %>"

  function checkCredentialChange() {
    const emailField = document.getElementById("email-field")
    const passwordField = document.getElementById("new-password-field")
    const currentSection = document.getElementById("current-password-section")
    const emailChanged = emailField && emailField.value !== originalEmail
    const passwordFilled = passwordField && passwordField.value.length > 0
    currentSection.style.display = (emailChanged || passwordFilled) ? "block" : "none"
  }
</script>
