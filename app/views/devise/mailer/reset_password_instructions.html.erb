<!-- Título -->
<h1 style="margin:0 0 8px; font-size:22px; font-weight:700; color:#1a3558; text-align:center;">
  Redefinição de senha
</h1>
<p style="margin:0 0 28px; font-size:14px; color:#718096; text-align:center; line-height:1.6;">
  Recebemos uma solicitação para redefinir a senha da sua conta.
</p>

<!-- Divider -->
<hr style="border:none; border-top:1px solid #e2e8f0; margin:0 0 28px;">

<!-- Corpo -->
<p style="margin:0 0 12px; font-size:15px; color:#2d3748; line-height:1.7;">
  Olá, <strong><%= @resource.name.presence || @resource.email %></strong>!
</p>
<p style="margin:0 0 28px; font-size:14px; color:#4a5568; line-height:1.7;">
  Clique no botão abaixo para criar uma nova senha. Este link é válido por <strong>6 horas</strong>.
</p>

<!-- Botão -->
<table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:28px;">
  <tr>
    <td align="center">
      <%= link_to edit_password_url(@resource, reset_password_token: @token),
            style: "display:inline-block; background: linear-gradient(135deg, #2b6cb0, #3182ce); color:#ffffff; font-size:15px; font-weight:600; text-decoration:none; padding:14px 36px; border-radius:10px; letter-spacing:0.2px;" do %>
        Redefinir minha senha
      <% end %>
    </td>
  </tr>
</table>

<!-- Link alternativo -->
<p style="margin:0 0 8px; font-size:12px; color:#a0aec0; text-align:center;">
  Ou copie e cole o link abaixo no seu navegador:
</p>
<p style="margin:0; font-size:11px; color:#718096; text-align:center; word-break:break-all;">
  <%= edit_password_url(@resource, reset_password_token: @token) %>
</p>
