<div class="tv-screen"
  data-controller="tv">

  <%# ── Cabeçalho ── %>
  <header class="tv-header">
    <%= link_to root_path, class: "tv-header__brand app-header__logo-link" do %>
      <%= image_tag "logo.svg", width: 30, height: 30, alt: "TriagemAI", style: "border-radius:7px;" %>
      <span class="app-header__logo-text">Triagem<strong>AI</strong></span>
      <span class="tv-header__name">— Painel de Chamadas</span>
    <% end %>
    <div class="tv-header__clock" data-tv-target="clock"></div>
  </header>

  <%# ── Destaque: última chamada ── %>
  <div class="tv-spotlight" data-tv-target="spotlight" style="display:none;">
    <div class="tv-spotlight__label"><%= t("app.tv.calling_now") %></div>
    <div class="tv-spotlight__ticket" data-tv-target="spotlightTicket"></div>
    <div class="tv-spotlight__name" data-tv-target="spotlightName"></div>
    <div class="tv-spotlight__urgency" data-tv-target="spotlightUrgency"></div>
    <div class="tv-spotlight__instruction"><%= t("app.tv.go_to_office") %></div>
  </div>

  <%# ── Lista da fila (+ check-in, na TV autorizada) ── %>
  <main class="tv-main <%= "tv-main--with-checkin" if @show_checkin %>">
    <% if @show_checkin %>
      <aside class="tv-checkin"
        data-controller="tv-checkin"
        data-tv-checkin-url-value="<%= tv_checkin_code_path %>">
        <div class="tv-checkin__title">Chegou? Faça seu check-in</div>
        <div class="tv-checkin__qr" data-tv-checkin-target="qr"></div>
        <div class="tv-checkin__hint">Escaneie o QR com a câmera do celular<br>ou digite o código no app:</div>
        <div class="tv-checkin__code" data-tv-checkin-target="code">······</div>
        <div class="tv-checkin__countdown">Novo código em <span data-tv-checkin-target="countdown">--</span>s</div>
        <div class="tv-checkin__help">Sem celular? Fale com a recepção.</div>
      </aside>
    <% end %>

    <div class="tv-main__queue">
    <div class="tv-queue-header">
      <span class="tv-queue-header__label"><%= t("app.tv.queue_label") %></span>
      <span class="tv-queue-header__count">
        <%= t("app.tv.total") %>: <strong data-tv-target="totalCount"><%= @called_entries.count %></strong>
      </span>
    </div>

    <div class="tv-table-wrap">
      <table class="tv-table" data-tv-target="queueTable">
        <thead>
          <tr>
            <th><%= t("app.tv.columns.ticket") %></th>
            <th><%= t("app.tv.columns.name") %></th>
            <th><%= t("app.tv.columns.urgency") %></th>
            <th><%= t("app.tv.columns.called_at") %></th>
          </tr>
        </thead>
        <tbody data-tv-target="queueBody">
          <% if @called_entries.empty? %>
            <tr class="tv-table__empty-row" data-tv-empty>
              <td colspan="4"><%= t("app.tv.no_calls") %></td>
            </tr>
          <% else %>
            <% @called_entries.each_with_index do |entry, idx| %>
              <tr class="tv-row <%= "tv-row--first" if idx == 0 %>" style="border-left: 5px solid <%= urgency_color(entry.urgency_level) %>;">
                <td class="tv-row__ticket"><%= entry.ticket_number %></td>
                <td class="tv-row__name"><%= entry.triage_session.user.name %></td>
                <td>
                  <span class="urgency-badge" style="<%= urgency_badge_style(entry.urgency_level) %>">
                    <%= entry.urgency_label %>
                  </span>
                </td>
                <td class="tv-row__time"><%= l(entry.called_at, format: :short) %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    </div>
  </main>

  <%# ── Rodapé ── %>
  <footer class="tv-footer">
    <span><%= t("app.tagline") %></span>
    <span class="tv-footer__url"><%= t("app.tv.footer_hint") %></span>
  </footer>

</div>
